# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Deployer private key (DeployRH.s.sol)
PRIVATE_KEY=

# Robinhood Chain RPC (testnet or mainnet)
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
# RH mainnet: https://rpc.mainnet.chain.robinhood.com

# Optional: override Uniswap v4 PoolManager (DeployRH defaults to testnet PM552)
# RH_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951

ANVIL_RPC_URL=http://localhost:8545
