# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Test private key (required for all deploy scripts)
PRIVATE_KEY=
# Deployer private key (required for mainnet deploy scripts)
PRIVATE_KEY_MAIN=

# RPC URLs
BSC_RPC_URL=https://bsc-dataseed.binance.org/
ANVIL_RPC_URL=http://localhost:8545

# Optional BSC mining deployment overrides. Defaults come from deployments/56/addresses.json.
# BSC_COMMUNITY_FACTORY=0x5597e814399906095ecaA5769A40394F58E5E0Cf
# BSC_BASKET_REGISTRY=0x5B45ad2c3A2B8b8989579162C4faE2D64598Cefe

# Optional: Etherscan API key for contract verification
BSCSCAN_API_KEY=

# Required by the staged Router / Index Broker NFT deployment scripts
NUTBOX_ROUTER_OWNER=
NUTBOX_ROUTER=
INDEX_BROKER_OWNER=

OWNER=0x871fb7006C5964B21695Ba20006021777A26146C
