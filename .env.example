# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Deployer private key (required for make deploy-rh-*)
PRIVATE_KEY=

# Optional: override Uniswap v4 PoolManager (normally auto-selected by chainId)
# RH mainnet (4663):  0x8366a39CC670B4001A1121B8F6A443A643e40951
# RH testnet (46630): 0x552815eF68E6eb418A3d65D0AA1043d93204F612
# RH_POOL_MANAGER=

# Optional: only if you need a custom RPC (defaults are in foundry.toml profiles)
# RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional Basket TVL mining deployment overrides
# Defaults are read from deployments/4663/addresses.json
# RH_COMMUNITY_FACTORY=0x24328DccA1bA54EeE82e2993F021802e64290486
# RH_BASKET_REGISTRY=0x1f997dEb6C8Ac7Bb4134Bc7c6bF23F623Cda25C6
# RH_NFT_MINING_POOL_FACTORY=0xb3A547F535bDc1b20Eb6fd97b9524F893A75708C

ANVIL_RPC_URL=http://localhost:8545
